  m_Script: {fileID: 11500000, guid: 58c92701ce974524aaaf397634f66786, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemName: "Boi de Maracan\xE3"
  description: "O Boi de Maracan\xE3 \xE9 um dos mais antigos e respeitados grupos
    de Bumba-meu-Boi do Maranh\xE3o, fundado no bairro de Maracan\xE3, em S\xE3o
    Lu\xEDs. Com sotaque de matraca, seu ritmo inconfund\xEDvel \xE9 marcado pelas
    batidas das matracas de madeira e pelos pandeir\xF5es. O Boi representa a for\xE7a
    da cultura popular maranhense e a resist\xEAncia das tradi\xE7\xF5es afro-ind\xEDgenas
    do estado."
  itemPhoto: {fileID: 21300000, guid: 008933461ce704140a69cc258ba5aa66, type: 3}
  infoPanel: {fileID: 1366044714}
  nameText: {fileID: 1664077040}
  descriptionText: {fileID: 1408392156}
  photoImage: {fileID: 1573359095}
  closeButton: {fileID: 478736439}
