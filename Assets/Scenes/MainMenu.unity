  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "O Caboclo de Pena \xE9 um dos personagens mais emblem\xE1ticos do Bumba-meu-Boi
    do Maranh\xE3o. Vestido com cocar de penas e trajes que remetem \xE0 ancestralidade
    ind\xEDgena, o Caboclo representa a heran\xE7a dos povos origin\xE1rios na forma\xE7\xE3o
    cultural maranhense. Seus movimentos na brincadeira s\xE3o cheios de energia
    e rever\xEAncia, conectando o sagrado ao festivo nas celebra\xE7\xF5es juninas
    do Espa\xE7o Humberto de Maracan\xE3."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ade741f71a700294bae98d023319ef16, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: ade741f71a700294bae98d023319ef16, type: 2}
