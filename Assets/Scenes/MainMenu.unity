  openPosition: {x: 0, y: 0.4, z: -0.6}
  slideSpeed: 3
  itemInDrawer: {fileID: 668778553}
  itemName: "Tradi\xE7\xE3o Hist\xF3rica \u2014 Boi de Maracan\xE3"
  description: "A tradi\xE7\xE3o do Bumba-meu-Boi de Maracan\xE3 remonta a d\xE9cadas
    de hist\xF3ria e resist\xEAncia cultural no Maranh\xE3o. Reconhecido como Patrim\xF4nio
    Cultural Imaterial do Brasil, o Bumba-meu-Boi re\xFAne elementos das culturas
    africana, ind\xEDgena e europeia em uma celebra\xE7\xE3o \xFAnica. O Boi de Maracan\xE3,
    com seu sotaque de matraca, \xE9 s\xEDmbolo vivo dessa tradi\xE7\xE3o, mantendo
    acesa a chama da identidade maranhense atrav\xE9s das gera\xE7\xF5es."
  itemPhoto: {fileID: 21300000, guid: 2dd28dc1430c3194095ed7c0b0d8ef98, type: 3}
  hoverColor: {r: 0.8, g: 0.6, b: 0.4, a: 1}
